{
  "recipes": {
    "tdmpc2-pushcube-train": {
      "name": "TD-MPC2 · PushCube 状态模型训练",
      "description": "Official TD-MPC2 network, losses and MPPI on real ManiSkill GPU state observations; budgeted training.",
      "task": "native", "direction": "control",
      "entrypoint": "wms.engines.tdmpc2.native:train",
      "runtime": {"native_key": "tdmpc2", "config_file": "runtime.json"},
      "seed": 0, "timeout_s": 14400,
      "inputs": {},
      "params": {"model_size": 5, "num_envs": 32, "steps": 102400, "buffer_size": 102400,
                 "steps_per_update": 8, "batch_size": 256, "checkpoint_every": 25600},
      "metrics": [{"name": "tdmpc2", "entrypoint": "wms.engines.tdmpc2.metrics:measure", "version": "tdmpc2/1"}],
      "tags": ["tdmpc2", "PushCube-v1", "train", "state-input", "S1", "S2", "S3", "S4", "S5", "S6"]
    },
    "tdmpc2-pushcube-eval": {
      "name": "TD-MPC2 · 检查点评测与录像",
      "description": "Load an existing trained checkpoint, execute seeded MPPI episodes, and record actual simulation. Task success is not a safety verdict.",
      "task": "native", "direction": "control",
      "entrypoint": "wms.engines.tdmpc2.native:policy_evaluate",
      "runtime": {"native_key": "tdmpc2", "config_file": "runtime.json"},
      "seed": 0, "timeout_s": 3600,
      "inputs": {"checkpoint": ""},
      "params": {"episodes": 10, "seed_start": 1000, "video_episodes": 2,
                 "action_noise_std": 0.0, "action_scale": 1.0, "observation_noise_std": 0.0},
      "metrics": [{"name": "tdmpc2", "entrypoint": "wms.engines.tdmpc2.metrics:measure", "version": "tdmpc2/1"}],
      "tags": ["tdmpc2", "PushCube-v1", "checkpoint-eval", "S4", "S5", "S6", "evaluation"]
    },
    "tdmpc2-pushcube-predict": {
      "name": "TD-MPC2 · 固定动作潜空间后果对照",
      "description": "Predict held-out real trajectory latents/rewards at fixed horizons; compare action-conditioned, zero-action and persistence predictions.",
      "task": "native", "direction": "control",
      "entrypoint": "wms.engines.tdmpc2.native:predict",
      "runtime": {"native_key": "tdmpc2", "config_file": "runtime.json"},
      "seed": 0, "timeout_s": 1800,
      "inputs": {"checkpoint": "", "evaluation_report": ""},
      "params": {"horizons": [1, 5]},
      "metrics": [{"name": "tdmpc2", "entrypoint": "wms.engines.tdmpc2.metrics:measure", "version": "tdmpc2/1"}],
      "tags": ["tdmpc2", "latent-prediction", "S2", "S3", "evaluation", "non_adversarial_failure"]
    }
  }
}
